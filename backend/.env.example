PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Use the same database as the main RentifyPro website.
MONGODB_URI=mongodb://127.0.0.1:27017/rentifypro
WEBSITE_BACKEND_DIR=C:/Users/charlie/rentifypro/backend

ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@example.com
# Development only. Prefer ADMIN_PASSWORD_HASH in production.
ADMIN_PASSWORD=replace-with-a-strong-password
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_PASSWORD_RESET_DEV_MODE=true

# Optional. Locally, the admin can reuse the website backend's SMTP settings
# through WEBSITE_BACKEND_DIR when these values are empty.
SMTP_SERVICE=gmail
SMTP_USER=
SMTP_PASS=
