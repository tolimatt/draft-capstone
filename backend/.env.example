PORT=5001
CLIENT_ORIGIN=http://localhost:5174

# Use the same database as the main RentifyPro website.
MONGODB_URI=mongodb://127.0.0.1:27017/rentifypro
# Optional standard Atlas URI; preferred over MONGODB_URI/MONGO_URI when configured.
MONGO_URI_DIRECT=
# Required when the Atlas URI does not include the application's database name.
MONGO_DB_NAME=rentifypro
MONGO_SERVER_SELECTION_TIMEOUT_MS=15000
WEBSITE_BACKEND_DIR=C:/Users/charlie/rentifypro/backend

ADMIN_NAME=System Admin
ADMIN_EMAIL=replace-with-admin@gmail.com
# Development only. Prefer ADMIN_PASSWORD_HASH in production.
ADMIN_PASSWORD=replace-with-a-strong-password
# Optional secret passkey used by the explicit credential-sync command.
ADMIN_SECRET_KEY=
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_PASSWORD_RESET_DEV_MODE=true

# Sign-in email needs working SMTP credentials. Gmail SMTP is the default;
# set SMTP_HOST, SMTP_PORT, and SMTP_SECURE for another provider.
# To inherit SMTP_USER and SMTP_PASS from the website backend's .env,
# remove or comment out the empty lines below.
SMTP_USER=
SMTP_PASS=

# Private/manual KYC comparison uses the same explicit fingerprint secret as the website backend.
# Supply its existing private random value (32+ characters); never copy a value into this example.
KYC_DOCUMENT_FINGERPRINT_SECRET=
# Optional OCR suggestions. Choose private_ocr only after configuring your owned checker endpoint.
# Manual comparison remains available with manual and does not contact Gemini.
KYC_DOCUMENT_PROVIDER=manual
KYC_PRIVATE_SERVICE_URL=
# Optional dedicated OCR key; blank inherits INTERNAL_API_KEY. Use the same selected key on website and Python.
KYC_PRIVATE_INTERNAL_API_KEY=
INTERNAL_API_KEY=
KYC_PRIVATE_REQUEST_TIMEOUT_MS=30000
